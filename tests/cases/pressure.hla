// Many `let` variables: every callee-saved register holds one, and an expression still needs scratch
// registers. The translator moves variables to the frame until the expressions fit.
extern printf(fmt, ...)

data table: ptr = 0
data cells: i64[8] = 0

fn pick(p: auto) {
    let a = 1
    let b = 2
    let c = 3
    let d = 4
    let e = 5
    let f = 6
    let g = 7
    let h = 8
    let k = 9
    let id = [p + 8]
    let target = [table + [p + 8] * 8]
    let sum = a + b + c + d + e + f + g + h + k
    return target + sum + id + ([table + [p] * 8] >>> 1)
}

fn main() {
    table = &cells
    for i in 0..8 { cells[i] = i * 100 }
    local pair: i64[2]
    pair[0] = 6
    pair[1] = 3
    let r = pick(&pair)
    printf("%d\n", r)
    return 0
}
