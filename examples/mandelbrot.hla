// ASCII Mandelbrot set: floating point in d-registers,
// sugar and plain FP instructions side by side
extern putchar

const W = 64
const H = 24
const MAX_ITER = 100

rodata shades = " .:-=+*#%"

fn main() {
    for row in 0..H {
        for col in 0..W {
            // map the character cell to a point c = cr + ci*i
            let cr: d8 = float(col) * (3.0 / 64.0) - 2.2
            let ci: d9 = float(row) * (2.4 / 24.0) - 1.2
            let zr: d10 = 0.0, zi: d11 = 0.0
            let n = 0
            while n < MAX_ITER {
                fmul d12, zr, zr        // instructions: zr^2 and zi^2
                fmul d13, zi, zi
                if d12 + d13 > 4.0 { break }
                zi = 2.0 * zr * zi + ci
                zr = d12 - d13 + cr
                n++
            }
            if n == MAX_ITER {
                putchar('@')            // inside the set
            } else {
                putchar(shades[n % 9])
            }
        }
        putchar('\n')
    }
}
