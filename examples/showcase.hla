// =====================================================================
//  HLA64 showcase: a tour through the language.
//  Registers are still registers — but with names, operators,
//  structured control flow, and the boring prologue/epilogue done for you.
// =====================================================================

extern printf(fmt, ...)
extern puts, putchar, strlen, malloc, free, qsort, fflush

// ---------------------------------------------------------------- constants
const N = 10
const BUF_SIZE = 64
const MASK = 0xFF00FF00FF00FF00

enum Color { Red, Green, Blue = 5, Purple }

struct Point {
    x: i64
    y: i64
}

struct Particle {
    pos: Point
    mass: i32
    flags: u8
}

// ---------------------------------------------------------------- data
data counter: i64 = 0
data numbers: i32[N] = [42, -7, 19, 3, 88, 0, -15, 61, 5, 27]
data primes_count: u32 = 0
data greeting = "Hello, HLA64!"
rodata names: ptr = ["zero", "one", "two", "three"]
data points: Point[3]
data sieve: u8[100]          // zero-filled (bss)
data pi: f64 = 3.141592653589793
data scale: f64[3] = [0.5, 1.5, 2.25]

// a global register variable: shared by every function, never saved/restored
alias ticks = x28

// ---------------------------------------------------------------- functions

// parameters without a register live in their ABI registers (x0, x1, ...)
fn add3(a, b, c) {
    return a + b + c
}

// recursion: n is moved into a callee-saved register so it survives the call
fn factorial(n: auto) {
    if n <= 1 {
        return 1
    }
    x0 = factorial(n - 1)
    return x0 * n
}

fn fib(n: x19) {
    if n < 2 { return n }
    let a = fib(n - 1)
    x0 = fib(n - 2)
    return a + x0
}

// greatest common divisor with a classic loop
fn gcd(a, b) {
    while b != 0 {
        let t: x9 = a % b
        a = b
        b = t
    }
    return a
}

// my own strlen: byte loads with post-increment addressing
fn my_strlen(s) {
    let p: x9 = s
    loop {
        w10 = u8[p++]
        if w10 == 0 { break }
    }
    return p - s - 1
}

// reverse a string into a buffer; auto parameters survive the call to my_strlen
fn reverse2(dst: auto, src: auto) {
    let len = my_strlen(src)
    let i = 0
    while i < len {
        u8[dst + i] = u8[src + len - i - 1]
        i++
    }
    u8[dst + len] = 0
    return dst
}

// sum of an array of i32 using indexed access with scaling
fn sum_numbers() {
    let s: x9 = 0
    for i: x10 in 0..N {
        s += numbers[i]
    }
    return s
}

// insertion sort on the global array
fn sort_numbers() {
    for i: x9 in 1..N {
        let key: w10 = numbers[i]
        let j: x11 = i - 1
        while j >= 0 && numbers[j] > key {
            w12 = numbers[j]
            numbers[j + 1] = w12
            j--
        }
        numbers[j + 1] = key
    }
}

fn print_numbers(title) {
    printf("%s:", title)
    for i in 0..N {
        x9 = numbers[i]
        printf(" %d", x9)
    }
    putchar('\n')
}

// sieve of Eratosthenes on a byte array
fn count_primes() {
    let unsigned count = 0
    for i in 2..100 {
        if sieve[i] == 0 {
            count++
            let j = i * i
            while j < 100 {
                sieve[j] = 1
                j += i
            }
        }
    }
    primes_count = count
    return count
}

// classify a number: if / elif / else and logical operators
fn classify(v) {
    if v == 0 {
        return "zero"
    } elif v < 0 && v > -10 {
        return "small negative"
    } elif v < 0 {
        return "negative"
    } else if v & 1 == 0 || v == 7 {
        return "even or seven"
    }
    return "odd"
}

// nested loops with a labelled break and continue
fn find_pair(target) {
    outer: for a in 1..20 {
        for b in a..20 {
            if a * b == target {
                printf("  %ld * %ld = %ld\n", a, b, target)
                break outer
            }
            if b > a + 10 { continue outer }
        }
    }
}

// floating point: d-registers with operators
fn circle_area(r: d0) {
    let pi_val: d1 = pi
    d0 = pi_val * r * r
    return d0
}

fn hypot(a: d0, b: d1) {
    return sqrt(a * a + b * b)
}

// writing to stdout with a raw syscall
fn write_str(s: auto) {
    fflush(0)                     // flush printf's buffer first
    let n = strlen(s)
    syscall(SYS_write, 1, s, n)
}

// raw assembler is always available; aliases work inside it
fn popcount(v) {
    let count: x9 = 0
    while v != 0 {
        and x10, v, #1      // raw instruction using the alias 'v'
        add count, count, x10
        v = v >>> 1
    }
    return count
}

// naked function: no prologue, you are in charge
naked fn twice(v) {
    lsl x0, x0, #1
    ret
}

// a function that takes a function pointer
fn apply(f: x9, v) {
    x0 = v
    x9(x0)
    return x0
}

fn square(v) { return v * v }

// stack-allocated buffer
fn int_to_str(v: auto) {
    local buf: u8[32]
    let p = &buf[31]
    u8[p] = 0
    let neg = v < 0
    if neg { v = -v }
    do {
        p--
        let d: x9 = v % 10
        u8[p] = d + '0'
        v = v / 10
    } while v != 0
    if neg {
        p--
        u8[p] = '-'
    }
    puts(p)
}

// comparator for qsort: called from C!
fn cmp_i32(a, b) {
    w9 = i32[a]
    w10 = i32[b]
    return w9 < w10 ? -1 : (w9 > w10 ? 1 : 0)
}

// ---------------------------------------------------------------- main
fn main() {
    puts(greeting)
    ticks = 0

    // arithmetic & expressions
    let a = 7, b = 5
    let c = (a + b) * (a - b) / 2 + (a << 3) - (b >> 1)
    printf("expr: (7+5)*(7-5)/2 + (7<<3) - (5>>1) = %ld\n", c)
    printf("add3(1,2,3) = %ld\n", add3(1, 2, 3))
    printf("10! = %ld\n", factorial(10))
    printf("fib(20) = %ld\n", fib(20))
    printf("gcd(1071, 462) = %ld\n", gcd(1071, 462))
    printf("min/max/abs: %ld %ld %ld\n", min(a, b), max(a, b), abs(-42))
    printf("bits: %lx %lx %lx\n", a & b, a | b, a ^ b)
    let m = MASK
    printf("mask & ~0xFF..: %lx, clz(1) = %ld\n", m & ~0xFF00000000000000, clz(1))
    printf("popcount(0xF0F0) = %ld\n", popcount(0xF0F0))
    printf("twice(21) = %ld\n", twice(21))
    printf("apply(square, 12) = %ld\n", apply(square, 12))

    // enums & structs
    printf("Color.Blue = %ld, Color.Purple = %ld, Color.count = %ld\n", Color.Blue, Color.Purple, Color.count)
    printf("sizeof(Point) = %ld, Particle.mass at %ld, sizeof(Particle) = %ld\n", sizeof(Point), Particle.mass, Particle.size)
    for i in 0..3 {
        let p = &points[i]
        [p + Point.x] = i * 10
        [p + Point.y] = i * 10 + 1
    }
    let p2 = &points[2]
    printf("points[2] = (%ld, %ld)\n", [p2 + Point.x], [p2 + Point.y])

    // strings
    printf("strlen(greeting) = %ld, my_strlen = %ld, len() = %ld\n", strlen(greeting), my_strlen(greeting), len(greeting))
    let buf = malloc(64)
    reverse2(buf, greeting)
    printf("reversed: %s\n", buf)
    free(buf)
    for i in 0..4 {
        x9 = names[i]
        printf("names[%ld] = %s\n", i, x9)
    }

    // arrays
    print_numbers("numbers")
    printf("sum = %ld\n", sum_numbers())
    sort_numbers()
    print_numbers("sorted ")
    numbers[0] = 1000
    qsort(&numbers, N, 4, cmp_i32)
    print_numbers("qsorted")

    // sieve
    printf("primes below 100: %d\n", count_primes())
    w9 = primes_count
    printf("primes_count (global) = %d\n", w9)

    // classification with if/elif/else
    for v in -12..=8 step 4 {
        printf("%3ld is %s\n", v, classify(v))
    }

    // labelled loops
    puts("find_pair(91):")
    find_pair(91)

    // global variables
    for i in 0..5 { counter += i }
    counter++
    printf("counter = %ld\n", counter)

    // floating point
    let r: d8 = 2.0
    d0 = circle_area(r)
    printf("area(r=2) = %.4f\n", d0)
    d0 = hypot(3.0, 4.0)
    printf("hypot(3, 4) = %.1f\n", d0)
    d1 = scale[2]
    d1 = d1 * float(a)
    printf("2.25 * 7 = %.2f, int = %ld\n", d1, int(d1))

    // syscall
    write_str("written with a raw syscall\n")

    // stack buffers
    int_to_str(-90210)
    int_to_str(0)

    // ternary & comparison values
    let big = a > b ? a : b
    let flag = a == 7
    printf("big = %ld, flag = %ld\n", big, flag)

    // push / pop and an asm block
    push a, b
    a = 100
    b = 200
    pop a, b
    asm {
        add ticks, ticks, #1
        mov x9, a
    }
    printf("after pop: a = %ld, b = %ld, ticks = %ld\n", a, b, ticks)

    // goto
    let k = 0
again:
    k++
    if k < 3 { goto again }
    printf("goto loop ran %ld times\n", k)

    return 0
}
