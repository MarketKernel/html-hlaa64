// lib/sha256.hla — SHA-256 (FIPS 180-4). Values are 32-bit, kept in 64-bit variables and cut
// to 32 bits with `& M32` after every operation that can carry over.

rodata sha_k: u32[64] = [
    0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5, 0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5,
    0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3, 0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174,
    0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc, 0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da,
    0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7, 0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967,
    0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13, 0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85,
    0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3, 0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070,
    0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5, 0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3,
    0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208, 0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2
]

data sha_h: i64[8]                    // the state while a message is hashed
data sha_w: i64[64]                   // the message schedule of a block
data sha_tail: u8[128]                // the last one or two blocks with the padding

const M32 = 0xFFFFFFFF

// one 64-byte block at p into sha_h
fn sha_block(p: auto) {
    for i in 0..16 {
        let q = p + i * 4
        sha_w[i] = u8[q] << 24 | u8[q + 1] << 16 | u8[q + 2] << 8 | u8[q + 3]
    }
    for i in 16..64 {
        let x = sha_w[i - 15]
        let y = sha_w[i - 2]
        // rotations: (v >>> n | v << (32 - n)), cut to 32 bits at the end
        let sig0 = ((x >>> 7 | x << 25) ^ (x >>> 18 | x << 14) ^ x >>> 3) & M32
        let sig1 = ((y >>> 17 | y << 15) ^ (y >>> 19 | y << 13) ^ y >>> 10) & M32
        sha_w[i] = (sha_w[i - 16] + sig0 + sha_w[i - 7] + sig1) & M32
    }
    let a = sha_h[0]
    let b = sha_h[1]
    let c = sha_h[2]
    let d = sha_h[3]
    let e = sha_h[4]
    let f = sha_h[5]
    let g = sha_h[6]
    let h = sha_h[7]
    for i in 0..64 {
        let sig1 = ((e >>> 6 | e << 26) ^ (e >>> 11 | e << 21) ^ (e >>> 25 | e << 7)) & M32
        let choose = e & f ^ (e ^ M32) & g
        let t1 = (h + sig1 + choose + sha_k[i] + sha_w[i]) & M32
        let sig0 = ((a >>> 2 | a << 30) ^ (a >>> 13 | a << 19) ^ (a >>> 22 | a << 10)) & M32
        let maj = a & b ^ a & c ^ b & c
        let t2 = (sig0 + maj) & M32
        h = g
        g = f
        f = e
        e = (d + t1) & M32
        d = c
        c = b
        b = a
        a = (t1 + t2) & M32
    }
    sha_h[0] = (sha_h[0] + a) & M32
    sha_h[1] = (sha_h[1] + b) & M32
    sha_h[2] = (sha_h[2] + c) & M32
    sha_h[3] = (sha_h[3] + d) & M32
    sha_h[4] = (sha_h[4] + e) & M32
    sha_h[5] = (sha_h[5] + f) & M32
    sha_h[6] = (sha_h[6] + g) & M32
    sha_h[7] = (sha_h[7] + h) & M32
}

// the 32-byte SHA-256 of the n bytes at p, written to out
fn sha256(p: auto, n: auto, out: auto) {
    sha_h[0] = 0x6a09e667
    sha_h[1] = 0xbb67ae85
    sha_h[2] = 0x3c6ef372
    sha_h[3] = 0xa54ff53a
    sha_h[4] = 0x510e527f
    sha_h[5] = 0x9b05688c
    sha_h[6] = 0x1f83d9ab
    sha_h[7] = 0x5be0cd19
    let full = n / 64 * 64
    let i = 0
    while i < full {
        sha_block(p + i)
        i = i + 64
    }
    // the rest, 0x80, zeros, and the length in bits (big-endian) at the end of the last block
    let rest = n - full
    for k in 0..128 { sha_tail[k] = 0 }
    mem_copy(sha_tail, p + full, rest)
    sha_tail[rest] = 0x80
    let blocks = 1
    if rest >= 56 { blocks = 2 }
    let end = blocks * 64
    let bits = n * 8
    for k in 0..8 { sha_tail[end - 1 - k] = bits >>> (k * 8) & 0xFF }
    sha_block(sha_tail)
    if blocks == 2 { sha_block(sha_tail + 64) }
    for k in 0..8 {
        let v = sha_h[k]
        u8[out + k * 4] = v >>> 24
        u8[out + k * 4 + 1] = v >>> 16
        u8[out + k * 4 + 2] = v >>> 8
        u8[out + k * 4 + 3] = v
    }
}
