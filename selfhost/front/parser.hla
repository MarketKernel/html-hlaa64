// front/parser.hla — tokens to the syntax tree. Top-level names (functions, data, constants,
// structs, enum members) are declared in the name table while parsing, so the code generator
// can use any of them, also before the place they are defined.

data pos: i64 = 0               // the current token

fn cur() { return toks + pos * Tok.size }
fn cur_kind() { return [toks + pos * Tok.size + Tok.kind] }
fn cur_nl() { return [toks + pos * Tok.size + Tok.nl] }
fn cur_val() { return [toks + pos * Tok.size + Tok.val] }

fn at_op(op) {
    let t = toks + pos * Tok.size
    return [t + Tok.kind] == TK.Op && [t + Tok.val] == op
}

fn at_kw(kw) {
    let t = toks + pos * Tok.size
    return [t + Tok.kind] == TK.Id && [t + Tok.val] == kw
}

fn accept_op(op: auto) {
    if at_op(op) {
        pos++
        return 1
    }
    return 0
}

fn expect_op(op: auto, text: auto) {
    if !at_op(op) { fail_tok(pos, text) }
    pos++
}

// the name id of the current token, which must be a name
fn expect_name(text: auto) {
    let t = cur()
    if [t + Tok.kind] != TK.Id { fail_tok(pos, text) }
    pos++
    return [t + Tok.val]
}

// a statement ends with `;`, a new line, `}` or the end of the file
fn end_stmt() {
    if accept_op(Op.Semi) { return 0 }
    if cur_nl() || cur_kind() == TK.Eof || at_op(Op.RBrace) { return 0 }
    fail_tok(pos, "expected the end of the statement")
    return 0
}

// declares a top-level name; one name cannot be defined twice
fn declare(id: auto, kind: auto, tok: auto) {
    let rec = name_at(id)
    if [rec + Name.kind] != Sym.None {
        if kind == Sym.Extern && [rec + Name.kind] == Sym.Extern { return rec }
        fail_name(tok, "already defined:", id)
    }
    if id < Kw.In { fail_name(tok, "a keyword cannot be a name:", id) }
    [rec + Name.kind] = kind
    [rec + Name.tok] = tok
    return rec
}

fn define_const(id: auto, v: auto, tok: auto) {
    let rec = declare(id, Sym.Const, tok)
    [rec + Name.val] = v
    [rec + Name.state] = 2
}

// expressions ----------------------------------------------------------------------------

// binding strength of a binary operator (0: not one); the same as Go
fn op_prec(op) {
    switch op {
        case Op.OrOr { return 1 }
        case Op.AndAnd { return 2 }
        case Op.Eq, Op.Ne, Op.Lt, Op.Le, Op.Gt, Op.Ge { return 3 }
        case Op.Plus, Op.Minus, Op.Pipe, Op.Caret { return 4 }
        case Op.Star, Op.Slash, Op.Percent, Op.Shl, Op.Shr, Op.Ushr, Op.Amp { return 5 }
    }
    return 0
}

fn parse_expr() {
    let i = pos
    let e = parse_binary(1)
    if !accept_op(Op.Question) { return e }
    let n = node(NK.Cond, i)
    [n + Node.a] = e
    [n + Node.b] = parse_expr()
    expect_op(Op.Colon, "expected ':' of ?:")
    [n + Node.c] = parse_expr()
    return n
}

// operators bind from left to right; an operator at the start of a line does not continue the
// expression of the line before
fn parse_binary(minp: auto) {
    let left = parse_unary()
    loop {
        let t = cur()
        if [t + Tok.kind] != TK.Op || [t + Tok.nl] != 0 { break }
        let op = [t + Tok.val]
        let p = op_prec(op)
        if p == 0 || p < minp { break }
        let i = pos
        pos++
        let right = parse_binary(p + 1)
        let n = node(NK.Binary, i)
        [n + Node.op] = op
        [n + Node.a] = left
        [n + Node.b] = right
        left = n
    }
    return left
}

fn parse_unary() {
    let i = pos
    if accept_op(Op.Minus) {
        let e = parse_unary()
        if [e + Node.kind] == NK.Num {
            [e + Node.val] = 0 - [e + Node.val]
            return e
        }
        let n = node(NK.Unary, i)
        [n + Node.op] = Op.Minus
        [n + Node.a] = e
        return n
    }
    if at_op(Op.Tilde) || at_op(Op.Bang) {
        let n = node(NK.Unary, i)
        [n + Node.op] = cur_val()
        pos++
        let e = parse_unary()
        [n + Node.a] = e
        return n
    }
    if accept_op(Op.Amp) {
        let n = node(NK.Addr, i)
        [n + Node.a] = parse_unary()
        return n
    }
    return parse_primary()
}

fn parse_primary() {
    let i = pos
    let t = cur()
    let kind = [t + Tok.kind]
    if kind == TK.Num {
        pos++
        return num_node([t + Tok.val], i)
    }
    if kind == TK.Str {
        pos++
        let n = node(NK.Str, i)
        [n + Node.a] = [t + Tok.sptr]
        [n + Node.val] = [t + Tok.slen]
        return n
    }
    if accept_op(Op.LParen) {
        let e = parse_expr()
        expect_op(Op.RParen, "expected ')'")
        return e
    }
    if accept_op(Op.LBrack) {
        let n = node(NK.Mem, i)
        [n + Node.op] = Ty.I64
        let e = parse_expr()
        [n + Node.a] = e
        expect_op(Op.RBrack, "expected ']'")
        return n
    }
    if kind != TK.Id { fail_tok(i, "expected an expression") }
    let id = [t + Tok.val]
    pos++
    if (id == Kw.Sizeof || id == Kw.Len) && at_op(Op.LParen) {
        let n = node(NK.SizeOf, i)
        if id == Kw.Len { [n + Node.kind] = NK.LenOf }
        expect_op(Op.LParen, "expected '('")
        [n + Node.val] = expect_name("expected a name")
        expect_op(Op.RParen, "expected ')'")
        return n
    }
    let ty = ty_of_kw(id)
    if ty != Ty.None && at_op(Op.LBrack) {
        // u8[address]
        pos++
        let n = node(NK.Mem, i)
        [n + Node.op] = ty
        let e = parse_expr()
        [n + Node.a] = e
        expect_op(Op.RBrack, "expected ']'")
        return n
    }
    if id < Kw.In { fail_name(i, "unexpected keyword", id) }
    if at_op(Op.LParen) {
        pos++
        let n = node(NK.Call, i)
        [n + Node.val] = id
        let count = 0
        let tail = 0
        while !at_op(Op.RParen) {
            let arg = parse_expr()
            if tail == 0 { [n + Node.a] = arg } else { [tail + Node.next] = arg }
            tail = arg
            count++
            if !accept_op(Op.Comma) { break }
        }
        expect_op(Op.RParen, "expected ')' after the arguments")
        [n + Node.op] = count
        return n
    }
    if at_op(Op.LBrack) && cur_nl() == 0 {
        pos++
        let n = node(NK.Index, i)
        [n + Node.val] = id
        [n + Node.a] = parse_expr()
        expect_op(Op.RBrack, "expected ']'")
        return n
    }
    let n = node(NK.Name, i)
    [n + Node.val] = id
    return n
}

// statements -----------------------------------------------------------------------------

// { statements } — the first statement of the list (0 when empty)
fn parse_block() {
    expect_op(Op.LBrace, "expected '{'")
    let head = 0
    let tail = 0
    loop {
        while accept_op(Op.Semi) { }
        if at_op(Op.RBrace) { break }
        if cur_kind() == TK.Eof { fail_tok(pos, "missing '}'") }
        let s = parse_stmt()
        if head == 0 { head = s } else { [tail + Node.next] = s }
        tail = s
        while [tail + Node.next] != 0 { tail = [tail + Node.next] }
    }
    pos++
    return head
}

// a block as one statement
fn block_stmt() {
    let n = node(NK.Block, pos)
    [n + Node.a] = parse_block()
    return n
}

// the operator of a compound assignment (`+=` gives Op.Plus), Op.Assign for `=`, -1 otherwise
fn assign_op(op) {
    switch op {
        case Op.Assign { return Op.Assign }
        case Op.AddSet { return Op.Plus }
        case Op.SubSet { return Op.Minus }
        case Op.MulSet { return Op.Star }
        case Op.DivSet { return Op.Slash }
        case Op.ModSet { return Op.Percent }
        case Op.AndSet { return Op.Amp }
        case Op.OrSet { return Op.Pipe }
        case Op.XorSet { return Op.Caret }
        case Op.ShlSet { return Op.Shl }
        case Op.ShrSet { return Op.Shr }
        case Op.UshrSet { return Op.Ushr }
    }
    return -1
}

fn parse_stmt() {
    let i = pos
    if at_op(Op.LBrace) { return block_stmt() }
    if cur_kind() == TK.Id {
        switch cur_val() {
            case Kw.Let, Kw.Var { return parse_let() }
            case Kw.Local { return parse_local() }
            case Kw.If { return parse_if() }
            case Kw.While {
                pos++
                let n = node(NK.While, i)
                let cond = parse_expr()
                [n + Node.a] = cond
                let body = parse_block()
                [n + Node.b] = body
                return n
            }
            case Kw.Do {
                pos++
                let n = node(NK.DoWhile, i)
                let body = parse_block()
                [n + Node.b] = body
                if !at_kw(Kw.While) { fail_tok(pos, "expected 'while' after the do block") }
                pos++
                [n + Node.a] = parse_expr()
                end_stmt()
                return n
            }
            case Kw.Loop {
                pos++
                let n = node(NK.Loop, i)
                [n + Node.b] = parse_block()
                return n
            }
            case Kw.For { return parse_for() }
            case Kw.Break, Kw.Continue {
                let n = node(NK.Break, i)
                if at_kw(Kw.Continue) { [n + Node.kind] = NK.Continue }
                pos++
                if cur_kind() == TK.Id && cur_nl() == 0 { fail_tok(pos, "loop labels are not supported") }
                end_stmt()
                return n
            }
            case Kw.Return {
                pos++
                let n = node(NK.Return, i)
                if cur_nl() == 0 && cur_kind() != TK.Eof && !at_op(Op.RBrace) && !at_op(Op.Semi) {
                    [n + Node.a] = parse_expr()
                }
                end_stmt()
                return n
            }
            case Kw.Switch { return parse_switch() }
        }
    }
    // assignment, ++ / --, or a call
    let target = parse_expr()
    let t = cur()
    if [t + Tok.kind] == TK.Op && [t + Tok.nl] == 0 {
        let op = [t + Tok.val]
        if op == Op.Inc || op == Op.Dec {
            pos++
            let n = node(NK.Assign, i)
            [n + Node.op] = Op.Plus
            if op == Op.Dec { [n + Node.op] = Op.Minus }
            [n + Node.a] = target
            [n + Node.b] = num_node(1, i)
            end_stmt()
            return n
        }
        let aop = assign_op(op)
        if aop >= 0 {
            pos++
            let n = node(NK.Assign, i)
            [n + Node.op] = aop
            [n + Node.a] = target
            [n + Node.b] = parse_expr()
            end_stmt()
            return n
        }
    }
    if [target + Node.kind] != NK.Call { fail_tok(i, "expected an assignment or a call") }
    let n = node(NK.ExprStmt, i)
    [n + Node.a] = target
    end_stmt()
    return n
}

// let a = 1, b, c: auto = f()      (`: auto` or a register is accepted and has no effect)
fn parse_let() {
    pos++
    let head = 0
    let tail = 0
    loop {
        let i = pos
        let id = expect_name("expected a variable name")
        if accept_op(Op.Colon) { expect_name("expected auto") }
        let n = node(NK.Let, i)
        [n + Node.val] = id
        if accept_op(Op.Assign) {
            [n + Node.a] = parse_expr()
        }
        if head == 0 { head = n } else { [tail + Node.next] = n }
        tail = n
        if !accept_op(Op.Comma) { break }
    }
    end_stmt()
    return head
}

// a type after `:` — the name id of i8 ... ptr or of a struct; [count] goes to n.b
fn parse_type(n: auto) {
    [n + Node.c] = expect_name("expected a type")
    if at_op(Op.LBrack) && cur_nl() == 0 {
        pos++
        [n + Node.b] = parse_expr()
        expect_op(Op.RBrack, "expected ']'")
    }
}

// local buf: u8[64] | local x: u8 = 1 | local x = 1 (i64); the initial value goes to Node.a
fn parse_local() {
    pos++
    let i = pos
    let n = node(NK.Local, i)
    [n + Node.val] = expect_name("expected a name")
    if at_op(Op.Assign) {
        [n + Node.c] = Kw.I64
    } else {
        expect_op(Op.Colon, "expected ':' and a type")
        parse_type(n)
    }
    if accept_op(Op.Assign) {
        [n + Node.a] = parse_expr()
    }
    end_stmt()
    return n
}

// if ... { } elif ... { } else { } — `elif` and `else if` are an If in the else part
fn parse_if() {
    let n = node(NK.If, pos)
    pos++
    [n + Node.a] = parse_expr()
    [n + Node.b] = parse_block()
    if at_kw(Kw.Elif) {
        let rest = parse_if()
        [n + Node.c] = rest
    } elif at_kw(Kw.Else) {
        pos++
        if at_kw(Kw.If) {
            let rest = parse_if()
            [n + Node.c] = rest
        } else {
            [n + Node.c] = block_stmt()
        }
    }
    return n
}

// for i in a..b { }    for i in a..=b step 2 { }
fn parse_for() {
    let n = node(NK.For, pos)
    pos++
    [n + Node.val] = expect_name("expected the loop variable")
    if accept_op(Op.Colon) { expect_name("expected auto") }
    if !at_kw(Kw.In) { fail_tok(pos, "expected 'in'") }
    pos++
    [n + Node.a] = parse_expr()
    if accept_op(Op.RangeIncl) { [n + Node.op] = 1 } else { expect_op(Op.Range, "expected '..' or '..='") }
    [n + Node.b] = parse_expr()
    if at_kw(Kw.Step) {
        pos++
        [n + Node.d] = parse_expr()
    }
    [n + Node.c] = parse_block()
    return n
}

// switch v { case 1, 2 { } case 'a'..='z' { } default { } }
fn parse_switch() {
    let n = node(NK.Switch, pos)
    pos++
    [n + Node.a] = parse_expr()
    expect_op(Op.LBrace, "expected '{' of the switch")
    let tail = 0
    let seen_default = 0
    loop {
        while accept_op(Op.Semi) { }
        if accept_op(Op.RBrace) { break }
        let c = node(NK.Case, pos)
        if at_kw(Kw.Default) || at_kw(Kw.Else) {
            if seen_default { fail_tok(pos, "a switch has only one default") }
            seen_default = 1
            pos++
        } elif at_kw(Kw.Case) {
            if seen_default { fail_tok(pos, "'case' after 'default'") }
            pos++
            let vtail = 0
            loop {
                let vi = pos
                let v = parse_expr()
                if at_op(Op.Range) || at_op(Op.RangeIncl) {
                    let r = node(NK.Range, vi)
                    if at_op(Op.RangeIncl) { [r + Node.op] = 1 }
                    pos++
                    [r + Node.a] = v
                    [r + Node.b] = parse_expr()
                    v = r
                }
                if vtail == 0 { [c + Node.a] = v } else { [vtail + Node.next] = v }
                vtail = v
                if !accept_op(Op.Comma) { break }
            }
        } else {
            fail_tok(pos, "expected 'case' or 'default'")
        }
        [c + Node.b] = parse_block()
        if tail == 0 { [n + Node.b] = c } else { [tail + Node.next] = c }
        tail = c
    }
    return n
}

// top level ------------------------------------------------------------------------------

fn parse_program() {
    loop {
        while accept_op(Op.Semi) { }
        if cur_kind() == TK.Eof { break }
        if cur_kind() != TK.Id { fail_tok(pos, "expected fn, data, const, struct, enum or extern") }
        let exported = 0
        if at_kw(Kw.Export) {
            exported = 1
            pos++
        }
        switch cur_val() {
            case Kw.Fn { parse_fn(exported) }
            case Kw.Extern { parse_extern() }
            case Kw.Const { parse_const() }
            case Kw.Data, Kw.Rodata { parse_data() }
            case Kw.Struct { parse_struct() }
            case Kw.Enum { parse_enum() }
            default { fail_tok(pos, "expected fn, data, const, struct, enum or extern") }
        }
    }
}

fn parse_fn(exported: auto) {
    pos++
    let i = pos
    let id = expect_name("expected a function name")
    let rec = declare(id, Sym.Fn, i)
    let f = node(NK.Fn, i)
    [f + Node.val] = id
    [f + Node.op] = exported
    [rec + Name.node] = f
    expect_op(Op.LParen, "expected '('")
    let tail = 0
    while !at_op(Op.RParen) {
        let p = node(NK.Param, pos)
        [p + Node.val] = expect_name("expected a parameter name")
        if accept_op(Op.Colon) {
            let tid = expect_name("expected a type or auto")
            [p + Node.op] = ty_of_kw(tid)
        }
        if tail == 0 { [f + Node.a] = p } else { [tail + Node.next] = p }
        tail = p
        if !accept_op(Op.Comma) { break }
    }
    expect_op(Op.RParen, "expected ')'")
    if accept_op(Op.Arrow) { expect_name("expected the result type") }
    [f + Node.b] = parse_block()
    add_item(f)
}

// extern puts, printf(fmt, ...)  — `...`: the arguments after the named ones are variadic
fn parse_extern() {
    pos++
    loop {
        let i = pos
        let id = expect_name("expected a function name")
        let rec = declare(id, Sym.Extern, i)
        let fixed = -1
        if accept_op(Op.LParen) {
            let count = 0
            let variadic = 0
            while !at_op(Op.RParen) {
                if accept_op(Op.Ellipsis) {
                    variadic = 1
                    break
                }
                expect_name("expected a parameter name")
                if accept_op(Op.Colon) { expect_name("expected a type") }
                count++
                if !accept_op(Op.Comma) { break }
            }
            expect_op(Op.RParen, "expected ')'")
            if variadic { fixed = count }
        }
        [rec + Name.val] = fixed
        if !accept_op(Op.Comma) { break }
    }
    end_stmt()
}

fn parse_const() {
    pos++
    let i = pos
    let id = expect_name("expected a constant name")
    let rec = declare(id, Sym.Const, i)
    expect_op(Op.Assign, "expected '='")
    [rec + Name.node] = parse_expr()
    end_stmt()
}

// enum Color { Red, Green = 5, Blue } — Color.Red = 0, Color.Green = 5, Color.Blue = 6, Color.count = 7
fn parse_enum() {
    pos++
    let eid = expect_name("expected an enum name")
    expect_op(Op.LBrace, "expected '{'")
    let v = 0
    loop {
        if at_op(Op.RBrace) { break }
        let i = pos
        let mid = expect_name("expected an enum member")
        if accept_op(Op.Assign) {
            let e = parse_expr()
            v = const_eval(e)
        }
        define_const(intern_dotted(eid, name_str(mid)), v, i)
        v++
        if !accept_op(Op.Comma) && !accept_op(Op.Semi) && cur_nl() == 0 && !at_op(Op.RBrace) {
            fail_tok(pos, "expected ',' or a new line")
        }
    }
    pos++
    define_const(intern_dotted(eid, "count"), v, pos)
}

fn align_up(v, a) { return (v + a - 1) / a * a }

// struct Point { x: i64, y: i64 } — Point.x = 0, Point.y = 8, Point.size = 16 (natural alignment)
fn parse_struct() {
    pos++
    let si = pos
    let sid = expect_name("expected a struct name")
    let rec = declare(sid, Sym.Struct, si)
    expect_op(Op.LBrace, "expected '{'")
    let off = 0
    let align = 1
    loop {
        if at_op(Op.RBrace) { break }
        let i = pos
        let fid = expect_name("expected a field name")
        expect_op(Op.Colon, "expected ':' and a type")
        let ti = pos
        let tid = expect_name("expected a type")
        let count = 1
        if at_op(Op.LBrack) && cur_nl() == 0 {
            pos++
            let ce = parse_expr()
            count = const_eval(ce)
            expect_op(Op.RBrack, "expected ']'")
        }
        let ty = ty_of_kw(tid)
        let fsize = 0
        let falign = 0
        if ty != Ty.None {
            fsize = ty_size(ty)
            falign = fsize
        } else {
            let srec = name_at(tid)
            if [srec + Name.kind] != Sym.Struct { fail_name(ti, "unknown type", tid) }
            fsize = [srec + Name.bytes]
            falign = [srec + Name.val]
        }
        off = align_up(off, falign)
        define_const(intern_dotted(sid, name_str(fid)), off, i)
        off = off + fsize * count
        if falign > align { align = falign }
        if !accept_op(Op.Comma) && !accept_op(Op.Semi) && cur_nl() == 0 && !at_op(Op.RBrace) {
            fail_tok(pos, "expected ',' or a new line")
        }
    }
    pos++
    let size = align_up(off, align)
    [rec + Name.bytes] = size
    [rec + Name.val] = align
    define_const(intern_dotted(sid, "size"), size, si)
}

// data name: type[count] = value    data name = "text"    rodata names: ptr = ["a", "b"]
fn parse_data() {
    let ro = at_kw(Kw.Rodata)
    pos++
    let i = pos
    let id = expect_name("expected a data name")
    let rec = declare(id, Sym.Data, i)
    let n = node(NK.Data, i)
    [n + Node.val] = id
    [n + Node.op] = ro
    [n + Node.c] = -1
    [rec + Name.node] = n
    if accept_op(Op.Colon) { parse_type(n) }
    if accept_op(Op.Assign) {
        if accept_op(Op.LBrack) {
            [n + Node.d] = 2
            let tail = 0
            while !at_op(Op.RBrack) {
                let e = parse_expr()
                if tail == 0 { [n + Node.a] = e } else { [tail + Node.next] = e }
                tail = e
                if !accept_op(Op.Comma) { break }
            }
            expect_op(Op.RBrack, "expected ']'")
        } else {
            [n + Node.d] = 1
            [n + Node.a] = parse_expr()
        }
    }
    end_stmt()
    add_item(n)
}
